# Runs bgw-autorestore.service 5 minutes after boot and every 15 minutes while up. These are
# monotonic timers: nothing is missed while the Pi is off (Persistent= only applies to OnCalendar=
# timers), and the boot-time run covers whatever happened in between.
[Unit]
Description=Run bgwcli autorestore periodically

[Timer]
OnBootSec=5min
OnUnitActiveSec=15min
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
