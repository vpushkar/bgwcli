# Copy to ~/.config/bgw/autorestore.env and chmod 600 it: both codes are credentials.
# Keep every value in single quotes: systemd's EnvironmentFile= and sh (set -a; . file) both
# strip them and read the text between them literally, so the unit and a shell see the same value.
# The access code you set on the gateway (Device > Access Code).
BGW_ACCESS_CODE='change-me'
# The code printed on the gateway's sticker; a factory reset reverts to it. When the primary code
# is rejected, autorestore logs in with this one instead. That alone is no reset: with the
# baseline still in place the run only logs a warning to update BGW_ACCESS_CODE.
BGW_FALLBACK_ACCESS_CODE='change-me-sticker'
# Optional: gateway address (default 192.168.1.254) and request timeout in ms (default 15000,
# at most 3600000).
#BGW_HOST='192.168.1.254'
#BGW_TIMEOUT_MS='30000'
