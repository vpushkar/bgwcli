# Copy to ~/.config/bgw/autorestore.env and chmod 600 it: both lines are credentials.
# The access code you set on the gateway (Device > Access Code).
BGW_ACCESS_CODE=change-me
# The code printed on the gateway's sticker; a factory reset reverts to it. When the primary
# code is rejected, autorestore logs in with this one instead and treats that as a reset signal.
BGW_FALLBACK_ACCESS_CODE=change-me-sticker
# Optional: gateway address (default 192.168.1.254) and request timeout in ms (default 15000).
#BGW_HOST=192.168.1.254
#BGW_TIMEOUT_MS=30000
